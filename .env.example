# Copy this file to .env (it is not committed) to change the settings of docker-compose.yml.

# Password of the PostgreSQL user "shopsphere"
POSTGRES_PASSWORD=shopsphere

# Signing key of the JWT access tokens: any random string of at least 32 characters, for example
# the output of "openssl rand -base64 48". Without it the development placeholder of the application is used.
SHOPSPHERE_JWT_SECRET=shopsphere-local-development-jwt-secret-change-me

# Ports published on the host
SHOPSPHERE_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
